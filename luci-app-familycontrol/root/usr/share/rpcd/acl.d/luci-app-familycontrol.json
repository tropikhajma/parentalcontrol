{
	"luci-app-familycontrol": {
		"description": "Manage family internet access",
		"read": {
			"ubus": {
				"familycontrol": [ "status", "devices" ]
			}
		},
		"write": {
			"ubus": {
				"familycontrol": [
					"set_paused",
					"save_person",
					"delete_person",
					"save_device",
					"delete_device",
					"set_mode",
					"add_extra",
					"save_schedule",
					"save_calendar"
				]
			}
		}
	}
}
