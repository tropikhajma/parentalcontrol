#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-3.0-or-later
# shellcheck disable=SC2034,SC3043
# rc.common consumes these globals and provides local() on OpenWrt ash.

USE_PROCD=1
START=95
STOP=10

start_service() {
	config_load familycontrol_telemetry

	local enabled
	config_get_bool enabled main enabled 0
	[ "$enabled" -eq 1 ] || return 0

	procd_open_instance
	procd_set_param command /usr/sbin/familycontrol-otel-loop
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger familycontrol_telemetry
}
